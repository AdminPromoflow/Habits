Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:app|config|database|bin|tests|docs|storage|tmp|translations)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:README\.md|router\.php|composer\.(?:json|lock))$ - [F,L,NC]
</IfModule>
<FilesMatch "\.(?:sql|md|log|json|ini|env|bak|zip)$">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "same-origin"
Header always set X-Frame-Options "DENY"
</IfModule>
