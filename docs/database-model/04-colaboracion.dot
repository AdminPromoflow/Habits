digraph Model {
graph [rankdir=LR, bgcolor="#FCFCFE", pad="0.6", nodesep="0.55", ranksep="1.7", splines=spline, outputorder=edgesfirst, fontname="Arial", labelloc=t, labeljust=l, newrank=true];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=11, color="#94A3B8", fontcolor="#475569", arrowsize=0.7, penwidth=1.2, labeldistance=3.8, labelangle=25];
label=<<FONT POINT-SIZE="28" COLOR="#17243B"><B>MyRemarkableMind · Colaboración e invitaciones</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#64748B">Todas las columnas · 5 tablas del dominio + 3 referencias · habit_id / category_id son mutuamente excluyentes</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#64748B">PK primaria · FK foránea · UQ parte de clave única · ? admite NULL · u = UNSIGNED · flecha: tabla referenciada → tabla hija</FONT>>;
