digraph Model {
graph [rankdir=LR, bgcolor="#FCFCFE", pad="0.6", nodesep="0.55", ranksep="1.7", splines=spline, outputorder=edgesfirst, fontname="Arial", labelloc=t, labeljust=l, newrank=true];
node [shape=plain, fontname="Arial"];
edge [fontname="Arial", fontsize=11, color="#94A3B8", fontcolor="#475569", arrowsize=0.7, penwidth=1.2, labeldistance=3.8, labelangle=25];
label=<<FONT POINT-SIZE="28" COLOR="#17243B"><B>MyRemarkableMind · Identidad, diagramas y soporte</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="13" COLOR="#64748B">Todas las columnas · 9 tablas · ENUM y restricciones completos en el diccionario HTML</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#64748B">PK primaria · FK foránea · UQ parte de clave única · ? admite NULL · u = UNSIGNED · flecha: tabla referenciada → tabla hija</FONT>>;
"users" [label=<<TABLE BORDER="1" BGCOLOR="white" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#6B4FD0" ALIGN="LEFT" CELLPADDING="10"><FONT COLOR="white" POINT-SIZE="15"><B>users</B></FONT></TD></TR><TR><TD PORT="in_id" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">id</FONT></TD><TD PORT="out_id" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">BIGINT u</FONT></TD></TR><TR><TD PORT="in_name" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">name</FONT></TD><TD PORT="out_name" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">VARCHAR(100)</FONT></TD></TR><TR><TD PORT="in_email" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>UQ</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">email</FONT></TD><TD PORT="out_email" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">VARCHAR(190)</FONT></TD></TR><TR><TD PORT="in_password_hash" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">password_hash</FONT></TD><TD PORT="out_password_hash" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">VARCHAR(255)</FONT></TD></TR><TR><TD PORT="in_status" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">status</FONT></TD><TD PORT="out_status" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">ENUM</FONT></TD></TR><TR><TD PORT="in_auth_version" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">auth_version</FONT></TD><TD PORT="out_auth_version" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">INT</FONT></TD></TR><TR><TD PORT="in_setup_token_hash" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">setup_token_hash?</FONT></TD><TD PORT="out_setup_token_hash" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">CHAR(64)</FONT></TD></TR><TR><TD PORT="in_setup_expires_at" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">setup_expires_at?</FONT></TD><TD PORT="out_setup_expires_at" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">DATETIME</FONT></TD></TR><TR><TD PORT="in_created_at" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">created_at</FONT></TD><TD PORT="out_created_at" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">TIMESTAMP</FONT></TD></TR></TABLE>>];
"user_roles" [label=<<TABLE BORDER="1" BGCOLOR="white" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#6B4FD0" ALIGN="LEFT" CELLPADDING="10"><FONT COLOR="white" POINT-SIZE="15"><B>user_roles</B></FONT></TD></TR><TR><TD PORT="in_user_id" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>PK/FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">user_id</FONT></TD><TD PORT="out_user_id" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">BIGINT u</FONT></TD></TR><TR><TD PORT="in_role" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">role</FONT></TD><TD PORT="out_role" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">ENUM</FONT></TD></TR></TABLE>>];
"user_settings" [label=<<TABLE BORDER="1" BGCOLOR="white" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#6B4FD0" ALIGN="LEFT" CELLPADDING="10"><FONT COLOR="white" POINT-SIZE="15"><B>user_settings</B></FONT></TD></TR><TR><TD PORT="in_user_id" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>PK/FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">user_id</FONT></TD><TD PORT="out_user_id" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">BIGINT u</FONT></TD></TR><TR><TD PORT="in_language" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">language</FONT></TD><TD PORT="out_language" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">ENUM</FONT></TD></TR><TR><TD PORT="in_timezone" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">timezone</FONT></TD><TD PORT="out_timezone" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">VARCHAR(80)</FONT></TD></TR><TR><TD PORT="in_theme" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">theme</FONT></TD><TD PORT="out_theme" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">ENUM</FONT></TD></TR><TR><TD PORT="in_notifications_enabled" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">notifications_enabled</FONT></TD><TD PORT="out_notifications_enabled" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">TINYINT(1)</FONT></TD></TR></TABLE>>];
"password_resets" [label=<<TABLE BORDER="1" BGCOLOR="white" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#6B4FD0" ALIGN="LEFT" CELLPADDING="10"><FONT COLOR="white" POINT-SIZE="15"><B>password_resets</B></FONT></TD></TR><TR><TD PORT="in_token_hash" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">token_hash</FONT></TD><TD PORT="out_token_hash" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">CHAR(64)</FONT></TD></TR><TR><TD PORT="in_user_id" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">user_id</FONT></TD><TD PORT="out_user_id" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">BIGINT u</FONT></TD></TR><TR><TD PORT="in_auth_version" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">auth_version</FONT></TD><TD PORT="out_auth_version" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">INT</FONT></TD></TR><TR><TD PORT="in_expires_at" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">expires_at</FONT></TD><TD PORT="out_expires_at" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">DATETIME</FONT></TD></TR><TR><TD PORT="in_created_at" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">created_at</FONT></TD><TD PORT="out_created_at" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">TIMESTAMP</FONT></TD></TR></TABLE>>];
"notifications" [label=<<TABLE BORDER="1" BGCOLOR="white" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#6B4FD0" ALIGN="LEFT" CELLPADDING="10"><FONT COLOR="white" POINT-SIZE="15"><B>notifications</B></FONT></TD></TR><TR><TD PORT="in_id" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">id</FONT></TD><TD PORT="out_id" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">BIGINT u</FONT></TD></TR><TR><TD PORT="in_user_id" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">user_id</FONT></TD><TD PORT="out_user_id" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">BIGINT u</FONT></TD></TR><TR><TD PORT="in_message_key" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">message_key</FONT></TD><TD PORT="out_message_key" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">VARCHAR(100)</FONT></TD></TR><TR><TD PORT="in_detail" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">detail</FONT></TD><TD PORT="out_detail" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">VARCHAR(1000)</FONT></TD></TR><TR><TD PORT="in_is_read" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">is_read</FONT></TD><TD PORT="out_is_read" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">TINYINT(1)</FONT></TD></TR><TR><TD PORT="in_created_at" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">created_at</FONT></TD><TD PORT="out_created_at" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">TIMESTAMP</FONT></TD></TR></TABLE>>];
"diagrams" [label=<<TABLE BORDER="1" BGCOLOR="white" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#6B4FD0" ALIGN="LEFT" CELLPADDING="10"><FONT COLOR="white" POINT-SIZE="15"><B>diagrams</B></FONT></TD></TR><TR><TD PORT="in_id" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">id</FONT></TD><TD PORT="out_id" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">BIGINT u</FONT></TD></TR><TR><TD PORT="in_owner_user_id" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>FK/UQ</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">owner_user_id</FONT></TD><TD PORT="out_owner_user_id" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">BIGINT u</FONT></TD></TR><TR><TD PORT="in_name" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">name</FONT></TD><TD PORT="out_name" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">VARCHAR(120)</FONT></TD></TR><TR><TD PORT="in_client_key" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>UQ</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">client_key</FONT></TD><TD PORT="out_client_key" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">CHAR(36)</FONT></TD></TR><TR><TD PORT="in_version" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">version</FONT></TD><TD PORT="out_version" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">INT u</FONT></TD></TR><TR><TD PORT="in_created_at" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">created_at</FONT></TD><TD PORT="out_created_at" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">TIMESTAMP</FONT></TD></TR><TR><TD PORT="in_updated_at" BGCOLOR="#F1EDFF" ALIGN="LEFT"><FONT COLOR="#6B4FD0" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">updated_at</FONT></TD><TD PORT="out_updated_at" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">TIMESTAMP</FONT></TD></TR></TABLE>>];
"platform_settings" [label=<<TABLE BORDER="1" BGCOLOR="white" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#5E6A7C" ALIGN="LEFT" CELLPADDING="10"><FONT COLOR="white" POINT-SIZE="15"><B>platform_settings</B></FONT></TD></TR><TR><TD PORT="in_setting_key" BGCOLOR="#F0F3F7" ALIGN="LEFT"><FONT COLOR="#5E6A7C" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">setting_key</FONT></TD><TD PORT="out_setting_key" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">VARCHAR(100)</FONT></TD></TR><TR><TD PORT="in_setting_value" BGCOLOR="#F0F3F7" ALIGN="LEFT"><FONT COLOR="#5E6A7C" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">setting_value</FONT></TD><TD PORT="out_setting_value" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">VARCHAR(1000)</FONT></TD></TR></TABLE>>];
"rate_limits" [label=<<TABLE BORDER="1" BGCOLOR="white" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#5E6A7C" ALIGN="LEFT" CELLPADDING="10"><FONT COLOR="white" POINT-SIZE="15"><B>rate_limits</B></FONT></TD></TR><TR><TD PORT="in_bucket" BGCOLOR="#F0F3F7" ALIGN="LEFT"><FONT COLOR="#5E6A7C" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">bucket</FONT></TD><TD PORT="out_bucket" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">CHAR(64)</FONT></TD></TR><TR><TD PORT="in_attempts" BGCOLOR="#F0F3F7" ALIGN="LEFT"><FONT COLOR="#5E6A7C" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">attempts</FONT></TD><TD PORT="out_attempts" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">INT</FONT></TD></TR><TR><TD PORT="in_expires_at" BGCOLOR="#F0F3F7" ALIGN="LEFT"><FONT COLOR="#5E6A7C" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">expires_at</FONT></TD><TD PORT="out_expires_at" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">DATETIME</FONT></TD></TR></TABLE>>];
"schema_migrations" [label=<<TABLE BORDER="1" BGCOLOR="white" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#5E6A7C" ALIGN="LEFT" CELLPADDING="10"><FONT COLOR="white" POINT-SIZE="15"><B>schema_migrations</B></FONT></TD></TR><TR><TD PORT="in_version" BGCOLOR="#F0F3F7" ALIGN="LEFT"><FONT COLOR="#5E6A7C" POINT-SIZE="10"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">version</FONT></TD><TD PORT="out_version" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">VARCHAR(190)</FONT></TD></TR><TR><TD PORT="in_checksum" BGCOLOR="#F0F3F7" ALIGN="LEFT"><FONT COLOR="#5E6A7C" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">checksum</FONT></TD><TD PORT="out_checksum" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">CHAR(64)</FONT></TD></TR><TR><TD PORT="in_applied_at" BGCOLOR="#F0F3F7" ALIGN="LEFT"><FONT COLOR="#5E6A7C" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">applied_at</FONT></TD><TD PORT="out_applied_at" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">TIMESTAMP</FONT></TD></TR></TABLE>>];
"users":"out_id":e -> "user_roles":"in_user_id":w [label="1 → 0..N", tooltip="users (1) → user_roles (0..N) por user_id"];
