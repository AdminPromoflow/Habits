"><FONT COLOR="#167B70" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">color</FONT></TD><TD PORT="out_color" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">CHAR(7)</FONT></TD></TR><TR><TD PORT="in_scope_key" BGCOLOR="#E8F6F2" ALIGN="LEFT"><FONT COLOR="#167B70" POINT-SIZE="10"><B>UQ</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">scope_key?</FONT></TD><TD PORT="out_scope_key" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">BIGINT u</FONT></TD></TR><TR><TD PORT="in_created_at" BGCOLOR="#E8F6F2" ALIGN="LEFT"><FONT COLOR="#167B70" POINT-SIZE="10"><B>&#160;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="12">created_at</FONT></TD><TD PORT="out_created_at" ALIGN="LEFT"><FONT COLOR="#64748B" POINT-SIZE="11">TIMESTAMP</FONT></TD></TR></TABLE>>];
